# Copy to `.env` (gitignored). Leave blank to stay on the free, local path.
# Only needed if you opt into a paid backend.

# ElevenLabs Scribe (premium transcription) — used only if transcribe.backend = "elevenlabs"
ELEVENLABS_API_KEY=

# Stock B-roll providers for the `stock` capability. Both keys are FREE:
# pexels.com/api and pixabay.com/api/docs. Openverse (images) and Imgflip
# (meme templates) work with no key at all — blank keys just mean fewer sources.
PEXELS_API_KEY=
PIXABAY_API_KEY=
